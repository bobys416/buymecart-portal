{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@buymecart/shared-types": [
        "../packages/shared-types/index.ts"
      ],
      "@buymecart/business-logic": [
        "../packages/business-logic/index.ts"
      ],
      "@buymecart/design-tokens": [
        "../packages/design-tokens/index.ts"
      ],
      "@buymecart/validation": [
        "../packages/validation/index.ts"
      ],
      "@buymecart/api-client": [
        "../packages/api-client/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "App.tsx"
  ],
  "extends": "expo/tsconfig.base"
}
