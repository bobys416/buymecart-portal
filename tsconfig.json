{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@buymecart/shared-types": ["packages/shared-types/index.ts"],
      "@buymecart/business-logic": ["packages/business-logic/index.ts"],
      "@buymecart/design-tokens": ["packages/design-tokens/index.ts"],
      "@buymecart/validation": ["packages/validation/index.ts"],
      "@buymecart/api-client": ["packages/api-client/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "typeRoots": ["./node_modules/@types"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "mobile", "mobile/**/*", "**/node_modules", "tests/mobile-app.test.tsx"]
}
