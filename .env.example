# ==============================================================================
# BUYMECART / IBNK FINTECH ENGINE — COMPLETE ENVIRONMENT CONFIGURATION
# Safe placeholders only. Never commit real production secrets or customer keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME MODE
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="BuyMeCart / IBNK API"
API_V1_STR=/api/v1
DEBUG=True
NEXT_PUBLIC_APP_MODE=sandbox

# API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT TOKENS
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=buymecart-fintech-secure-signing-key-dev-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite for local development; PostgreSQL / Supabase for staging & production
DATABASE_URL=sqlite:///./buymecart_dev.db
TEST_DATABASE_URL=sqlite:///./buymecart_test.db
# Production example:
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/buymecart

# ------------------------------------------------------------------------------
# 4. STORAGE & DOCUMENT VAULT
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_DOCUMENT_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
DOCUMENT_SIGNED_URL_EXPIRE_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. BSPARK PAYMENT GATEWAY (PROPRIETARY ENGINE)
# ------------------------------------------------------------------------------
BSPARK_GATEWAY_URL=https://api.bsparkgateway.internal/v1
BSPARK_GATEWAY_API_KEY_REF=kms://vault/bspark/gateway/sandbox/api_key
BSPARK_GATEWAY_WEBHOOK_SECRET_REF=kms://vault/bspark/gateway/sandbox/webhook_secret

# ------------------------------------------------------------------------------
# 6. PAYMENT SECURITY & INTEGRITY
# ------------------------------------------------------------------------------
ENABLE_LIVE_BANKING=False
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=buymecart-provider-webhook-secret-dev-2026
VAULT_ENCRYPTION_KEY=bspark_kms_local_dev_secret_key_32_bytes_len!
SSRF_APPROVED_HOSTS=api.bsparkgateway.internal,sandbox.bank.internal,127.0.0.1,localhost

# ------------------------------------------------------------------------------
# 7. NPCI / UPI CONFIGURATION
# ------------------------------------------------------------------------------
UPI_MERCHANT_VPA=buymecart@icici
UPI_MERCHANT_NAME=Buymecart Financial Services
UPI_MCC=5411

# ------------------------------------------------------------------------------
# 8. THIRD-PARTY MOCK / SANDBOX FALLBACK RAILS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_buymecart_sandbox
RAZORPAY_KEY_SECRET=rzp_secret_buymecart_sandbox
RAZORPAY_WEBHOOK_SECRET=whsec_rzp_buymecart_test

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_buymecart_sandbox
STRIPE_SECRET_KEY=sk_test_buymecart_sandbox
STRIPE_WEBHOOK_SECRET=whsec_stripe_buymecart_test
