# ==============================================================================
# BUYMECART / IBNK FINTECH BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the actual .env file with secrets into version control.

# Application Environment (development | staging | production | test)
ENVIRONMENT=development
PROJECT_NAME="BuyMeCart / IBNK API"
API_V1_STR=/api/v1
DEBUG=true

# Security & JWT Configuration
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-production-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (JSON array of allowed origins or comma-separated list)
# Wildcards ("*") are strictly prohibited with credentialed cookie requests.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","exp://localhost:8081"]

# Database Configuration
# Local SQLite default for zero-dependency development:
DATABASE_URL=sqlite:///./buymecart_dev.db

# Supabase PostgreSQL (Production / Staging / AWS ECS Deployment):
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Transaction Pooler Connection (Port 6543 - Recommended for serverless/lambda):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Isolated Test Database (Never run tests against production!)
TEST_DATABASE_URL=sqlite:///./buymecart_test.db

# Rate Limiting (Requests per minute per IP on authentication endpoints)
RATE_LIMIT_PER_MINUTE=30

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
